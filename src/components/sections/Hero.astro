---
import { getProjects } from "../../lib/site";
import ProjectCards from "../ProjectCards.astro";
import { withBase } from "../../lib/urls";
import Icon from "../Icon.astro";
const projects = await getProjects();
---
<section id="hero" class="project-library" aria-labelledby="project-library-title">
  <header class="project-library-header">
    <h2 id="project-library-title" class="h3">SELECTED WORKS</h2>
  </header>
  <ProjectCards projects={projects} />
  <div class="project-library-footer">
    <a class="landing-link portfolio-button" href={withBase("/film-video")}>
      SEE OUR FULL PORTFOLIO
      <Icon name="arrow-up-right" size={20} />
    </a>
  </div>
</section>
