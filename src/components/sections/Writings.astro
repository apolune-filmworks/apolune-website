---
import { withBase } from "../../lib/urls";
import apolunePostLogo from "../../assets/publications/the-apolune-post.webp";
import { site } from "../../lib/site";
import ScrollFade from "../ScrollFade.astro";
interface Props { dedicated?: boolean; }
const { dedicated = false } = Astro.props;
const { writings } = site;
const Heading = dedicated ? "h1" : "h2";
const publicationNames = /((?:The Apolune Post)|(?:LINE OF BEST FIT: Dispatches from the Long Road to Liberty))/g;
const copyParts = writings.text.split(publicationNames);
---
<section class:list={["writings", { "writings-dedicated": dedicated }]} aria-labelledby="writings-title">
  <img class="writings-backdrop" src={writings.image} alt="Painted angels among trees and red ribbons" loading="lazy" />
  <div class="writings-shade" aria-hidden="true"></div>
  <div class="writings-content">
    <Heading id="writings-title" class="h2">{writings.heading}</Heading>
    <ScrollFade><p class="writings-copy">{copyParts.map((part, index) => index % 2 ? <em>{part}</em> : part)}</p></ScrollFade>
    {dedicated ? (
      <div class="publication-grid">
        {writings.publications.map((publication) => (
          <article class="publication">
            <div class="publication-logo"><img src={publication.label === "THE APOLUNE POST" ? apolunePostLogo.src : publication.logo} alt={publication.logoAlt} loading="lazy" /></div>
            <a class="landing-link" href={publication.href}>{publication.label}</a>
            <p>{publication.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="writings-links"><a class="landing-link" href={withBase("/writing")}>EXPLORE OUR WRITINGS</a></div>
    )}
  </div>
</section>
