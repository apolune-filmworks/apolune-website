---
import { withBase } from "../../lib/urls";
import apolunePostLogo from "../../assets/publications/the-apolune-post.webp";
import { site } from "../../lib/site";
import ScrollFade from "../ScrollFade.astro";
interface Props { dedicated?: boolean; }
const { dedicated = false } = Astro.props;
const { writings } = site;
const Heading = dedicated ? "h1" : "h2";
const publicationNames = /((?:American Delusion)|(?:The Apolune Post)|(?:LINE OF BEST FIT: Dispatches from the Long Road to Liberty))/g;
const copyParts = writings.text.split(publicationNames);
---
<section class:list={["writings", { "writings-dedicated": dedicated }]} aria-labelledby="writings-title">
  <img class="writings-backdrop" src={writings.image} alt="Painted angels among trees and red ribbons" loading="lazy" />
  <div class="writings-shade" aria-hidden="true"></div>
  <div class="writings-content">
    <Heading id="writings-title" class="h2">{writings.heading}</Heading>
    <ScrollFade><p class="writings-copy">{copyParts.map((part, index) => index % 2 ? <em>{part}</em> : part)}</p></ScrollFade>
    {dedicated ? (
      <article class="book-feature">
        <a class="book-photo" href="https://www.amazon.ca/American-Delusion-Collected-Ansel-Tan/dp/B0GT7J96GY" aria-label="American Delusion by Ansel Tan — view the book on Amazon">
          <img src={withBase("/assets/publications/american-delusion-1200.webp")} srcset={`${withBase("/assets/publications/american-delusion-640.webp")} 640w, ${withBase("/assets/publications/american-delusion-1200.webp")} 1200w`} sizes="(max-width: 809px) calc(100vw - 40px), 550px" width="1200" height="900" alt="American Delusion by Ansel Tan beside a Canon camera, photographs, and handwritten notes on a map" loading="lazy" decoding="async" />
        </a>
        <div class="book-copy">
          <p class="work-eyebrow">AN ORIGINAL BOOK / ANSEL TAN</p>
          <h2>American Delusion.</h2>
          <p>A book by Ansel Tan, part of the original writing behind Apolune. Explore <em>American Delusion</em> and find your copy on Amazon.</p>
          <a class="landing-link" href="https://www.amazon.ca/American-Delusion-Collected-Ansel-Tan/dp/B0GT7J96GY">EXPLORE THE BOOK ↗</a>
        </div>
      </article>
      <div class="publication-grid">
        {writings.publications.map((publication) => (
          <article class="publication">
            <div class="publication-logo"><img src={publication.label === "THE APOLUNE POST" ? apolunePostLogo.src : publication.logo} alt={publication.logoAlt} loading="lazy" /></div>
            <a class="landing-link" href={publication.href}>{publication.label}</a>
            <p>{publication.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="writings-preview-grid">
        <a class="writings-preview" href="https://www.amazon.ca/American-Delusion-Collected-Ansel-Tan/dp/B0GT7J96GY">
          <div class="writings-preview-image writings-preview-image--photo"><img src={withBase("/assets/publications/american-delusion-640.webp")} width="640" height="480" alt="American Delusion beside a camera, photographs, and handwritten notes" loading="lazy" decoding="async" /></div>
          <span class="writings-preview-label">AMERICAN DELUSION ↗</span>
          <p>An original book by Ansel Tan.</p>
        </a>
        {writings.publications.map((publication) => <a class="writings-preview" href={publication.href}>
          <div class="writings-preview-image"><img src={publication.label === "THE APOLUNE POST" ? apolunePostLogo.src : withBase(publication.logo)} alt={publication.logoAlt} loading="lazy" decoding="async" /></div>
          <span class="writings-preview-label">{publication.label} ↗</span>
          <p>{publication.description}</p>
        </a>)}
      </div>
      <a class="landing-link" href={withBase("/writing")}>EXPLORE ALL OUR WRITINGS</a>
    )}
  </div>
</section>
<style>
  .writings:not(.writings-dedicated) .writings-content { width: 100%; max-width: 1200px; }
  .writings-preview-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; width: 100%; }
  .writings-preview { display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 20px 20px 28px; border: 1px solid rgba(244,234,217,.3); background: rgba(4,9,27,.88); color: #f4ead9; }
  .writings-preview-image { display: grid; place-items: center; width: 100%; aspect-ratio: 4 / 3; }
  .writings-preview-image img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .writings-preview-image--photo img { height: auto; }
  .writings-preview-label { font-family: var(--font-heading); font-size: 14px; line-height: 1.5; letter-spacing: .04em; }
  .writings-preview p { font-family: var(--font-serif); font-size: 21px; line-height: 1.4; }
  .writings-preview:hover { border-color: #f4ead9; }
  .writings-preview:focus-visible { outline: 2px solid #f4ead9; outline-offset: 4px; }
  @media (max-width: 809px) { .writings-preview-grid { grid-template-columns: 1fr; max-width: 480px; } }
</style>
