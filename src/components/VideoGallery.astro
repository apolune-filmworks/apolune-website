---
import portfolioVideos from "../data/portfolio-videos.json";
const isPublicationWork = (publisher: string) => /soundguys|android authority/i.test(publisher);
// Horizontal first; independent work leads within each format. Stable sorting
// preserves the newer-first channel ordering within each group.
const videos = [...portfolioVideos].sort((a, b) =>
  Number(a.format === 'shorts') - Number(b.format === 'shorts') ||
  Number(isPublicationWork(a.publisher)) - Number(isPublicationWork(b.publisher)) ||
  (Number('priority' in a ? a.priority : 100) - Number('priority' in b ? b.priority : 100)) ||
  (Number('year' in b ? b.year : 0) - Number('year' in a ? a.year : 0))
);
const videoUrl = (video: (typeof videos)[number]) => "url" in video ? video.url : `https://www.youtube.com/watch?v=${video.id}`;
const isInstagram = (video: (typeof videos)[number]) => "provider" in video && video.provider === "instagram";
const categories = [{ id: 'all', label: 'All Videos' }, { id: 'music', label: 'Live Music & Music Videos' }, { id: 'originals', label: 'Original Films' }, { id: 'campaigns', label: 'Campaigns' }, { id: 'events', label: 'Event Coverage' }, { id: 'tech', label: 'Tech & Editorial' }, { id: 'studio', label: 'Studio & Podcast' }];
---
<section class="video-library work-wrap" aria-label="Selected video work">
  <div class="video-tools">
    <div class="video-filters" role="group" aria-label="Video format">
      <button type="button" data-format="all" aria-pressed="true">All Formats</button>
      <button type="button" data-format="longform" aria-pressed="false">Longform</button>
      <button type="button" data-format="shorts" aria-pressed="false">Vertical Shorts</button>
    </div>
    <label class="video-search">SEARCH VIDEOS<input type="search" data-video-search placeholder="Search titles, publications, or events…" /></label>
  </div>
  <div class="video-filter-bar">
    <div class="video-filters" role="group" aria-label="Filter video work">
      {categories.map(category => <button type="button" data-video-filter={category.id} aria-pressed={category.id === 'all'}>{category.label}<span>{videos.filter(video => category.id === 'all' || ("categories" in video ? video.categories : [video.category]).includes(category.id)).length}</span></button>)}
    </div>
    <p data-video-results role="status" aria-live="polite">{videos.length} videos</p>
  </div>
  <div class="video-grid">
    {videos.map(video => <article class="video-card" data-video-category={("categories" in video ? video.categories : [video.category]).join(" ")} data-editorial-priority={"editorialPriority" in video && video.editorialPriority ? "true" : undefined} data-video-format={video.format} data-video-search-text={`${video.title} ${video.publisher}`} hidden={videos.indexOf(video) >= 12}>
      <a class:list={["video-poster", { "video-poster--short": video.format === "shorts" }]} href={videoUrl(video)} target={"openExternal" in video && video.openExternal ? "_blank" : undefined} rel={"openExternal" in video && video.openExternal ? "noopener noreferrer" : undefined} data-open-external={"openExternal" in video && video.openExternal ? "true" : undefined} data-video-id={video.id} data-video-provider={isInstagram(video) ? "instagram" : "youtube"} data-video-title={video.title} data-video-start={"start" in video ? video.start : 0} data-video-format={video.format} aria-label={`Play ${video.title}`}>
        <img src={video.thumbnail} alt="" loading="lazy" width="480" height="360" />
        <span class="video-play" aria-hidden="true">▶</span>
        <span class="video-watch" aria-hidden="true">{video.format === "shorts" ? "WATCH SHORT ↗" : "WATCH VIDEO ↗"}</span>
      </a>
      <div class="video-card-copy"><p class="video-publisher">{video.publisher} · {video.format === "shorts" ? "VERTICAL SHORT" : "LONGFORM"}</p><h3 class:list={{ "video-title--long": video.title.length > 65 }}>{video.title}</h3><a href={videoUrl(video)} target="_blank" rel="noopener noreferrer">{isInstagram(video) ? "WATCH ON INSTAGRAM ↗" : "WATCH ON YOUTUBE ↗"}</a></div>
    </article>)}
  </div>
  <p class="video-empty" data-video-empty hidden>No videos match your search. Try another title or category.</p>
  <button class="video-more" type="button" data-video-more>SHOW MORE VIDEOS</button>
  <dialog class="video-dialog" aria-label="Video player">
    <div class="video-dialog-heading"><p data-playing-title></p><button type="button" data-video-close aria-label="Close video player">CLOSE ✕</button></div>
    <div class="video-player" data-video-player></div>
    <a data-youtube-link target="_blank" rel="noopener noreferrer">WATCH ON YOUTUBE ↗</a>
  </dialog>
</section>
<style>
  .video-tools { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; }
  .video-search { display: grid; gap: 8px; font-family: var(--font-heading); font-size: 10px; letter-spacing: .08em; }
  .video-search input { width: min(350px, 100%); padding: 12px; border: 1px solid #f4ead950; background: #04091b; color: #f4ead9; font: inherit; font-size: 13px; letter-spacing: 0; }
  .video-more { display: block; margin: 32px auto 0; padding: 16px 24px; border: 1px solid #f4ead980; background: transparent; color: #f4ead9; font-family: var(--font-heading); cursor: pointer; }
  .video-more[hidden], .video-empty[hidden] { display: none; }
  .video-empty { padding-block: 40px; font-family: var(--font-serif); font-size: 24px; }
  .video-poster.video-poster--short { aspect-ratio: 9 / 16; width: min(100%, 248px); margin-inline: auto; }
  .video-poster img { object-position: center; }
  .video-dialog[data-format="shorts"] { width: min(420px, calc(100% - 32px)); }
  .video-dialog[data-format="shorts"] .video-player { aspect-ratio: 9 / 16; max-height: 68dvh; }
  .video-library { padding-bottom: clamp(56px, 8vw, 120px); }
  .video-filter-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; padding-block: 16px; margin-bottom: 24px; border-block: 1px solid #f4ead940; font-family: var(--font-heading); font-size: 12px; }
  .video-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .video-filters button { display: flex; gap: 10px; align-items: center; padding: 12px 16px; border: 1px solid transparent; background: transparent; color: #f4ead9; cursor: pointer; font: inherit; font-size: 13px; }
  .video-filters button span { opacity: .65; font-size: 10px; }
  .video-filters button[aria-pressed="true"] { background: #f4ead9; color: #04091b; }
  .video-filters button:hover { border-color: #f4ead980; }
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
  .video-card { min-width: 0; border: 1px solid #f4ead940; background: #04091bcc; }
  .video-card[hidden] { display: none; }
  .video-poster { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 9; background: #000; overflow: hidden; color: #f4ead9; }
  .video-poster img { object-position: center; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .video-play { position: relative; display: grid; place-items: center; width: 56px; height: 56px; border: 1px solid #f4ead999; border-radius: 50%; background: #04091bdd; font-size: 18px; }
  .video-watch { position: absolute; bottom: 12px; right: 12px; padding: 6px 8px; background: #04091bdd; font-family: var(--font-heading); font-size: 10px; letter-spacing: .08em; }
  .video-card-copy { padding: 22px; }
  .video-publisher { margin-bottom: 12px; font-family: var(--font-heading); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .video-card h3 { font-family: var(--font-serif); font-size: 25px; line-height: 1.2; }
  .video-card h3.video-title--long { font-size: 21px; line-height: 1.25; }
  .video-card-copy > a, .video-dialog > a { display: inline-block; margin-top: 22px; font-family: var(--font-heading); font-size: 10px; letter-spacing: .06em; }
  .video-dialog { width: min(1100px, calc(100% - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 24px; border: 1px solid #f4ead950; background: #04091b; color: #f4ead9; }
  .video-dialog::backdrop { background: #02040bf2; }
  .video-dialog-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 20px; font-family: var(--font-heading); font-size: 14px; }
  .video-dialog-heading button { flex-shrink: 0; padding: 10px; background: transparent; color: inherit; border: 1px solid #f4ead950; cursor: pointer; font-size: 11px; }
  .video-player { aspect-ratio: 16 / 9; }
  .video-player :global(iframe) { width: 100%; height: 100%; border: 0; }
  button:focus-visible, a:focus-visible { outline: 2px solid #f4ead9; outline-offset: 4px; }
  @media (max-width: 1100px) { .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .video-grid { grid-template-columns: 1fr; } .video-filters { gap: 4px; } .video-filters button { padding: 10px 12px; } .video-dialog { padding: 12px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.video-library').forEach(library => {
    const cards = Array.from(library.querySelectorAll<HTMLElement>('[data-video-category]'));
    let category = 'all';
    let format = 'all';
    let limit = 12;
    const search = library.querySelector<HTMLInputElement>('[data-video-search]')!;
    const more = library.querySelector<HTMLButtonElement>('[data-video-more]')!;
    const update = () => {
      const query = search.value.trim().toLowerCase();
      const matches = cards.filter(card => (category === 'all' || card.dataset.videoCategory?.split(' ').includes(category)) && (format === 'all' || card.dataset.videoFormat === format) && (card.dataset.videoSearchText ?? '').toLowerCase().includes(query));
      if (category === 'tech') {
        matches.sort((a, b) => Number(b.dataset.editorialPriority === 'true') - Number(a.dataset.editorialPriority === 'true'));
      }
      if (category === 'events') {
        matches.sort((a, b) => Number(b.querySelector('[data-video-id="DZqIBItvCyL"]') !== null) - Number(a.querySelector('[data-video-id="DZqIBItvCyL"]') !== null));
      }
      const grid = library.querySelector<HTMLElement>('.video-grid')!;
      grid.append(...matches, ...cards.filter(card => !matches.includes(card)));
      const shown = new Set(matches.slice(0, limit));
      cards.forEach(card => { card.hidden = !shown.has(card); });
      library.querySelector('[data-video-results]')!.textContent = `${Math.min(limit, matches.length)} of ${matches.length} videos`;
      more.hidden = matches.length <= limit;
      library.querySelector<HTMLElement>('[data-video-empty]')!.hidden = matches.length > 0;
      library.querySelectorAll<HTMLButtonElement>('[data-video-filter]').forEach(button => {
        const count = cards.filter(card => (button.dataset.videoFilter === 'all' || card.dataset.videoCategory?.split(' ').includes(button.dataset.videoFilter!)) && (format === 'all' || card.dataset.videoFormat === format) && (card.dataset.videoSearchText ?? '').toLowerCase().includes(query)).length;
        button.querySelector('span')!.textContent = String(count);
      });
    };
    library.querySelectorAll<HTMLButtonElement>('[data-video-filter]').forEach(button => button.addEventListener('click', () => {
      category = button.dataset.videoFilter!; limit = 12;
      library.querySelectorAll('[data-video-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      update();
    }));
    library.querySelectorAll<HTMLButtonElement>('button[data-format]').forEach(button => button.addEventListener('click', () => {
      format = button.dataset.format!; limit = 12;
      library.querySelectorAll('button[data-format]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      update();
    }));
    search.addEventListener('input', () => { limit = 12; update(); });
    more.addEventListener('click', () => {
      const previous = cards.filter(card => !card.hidden).length;
      limit += 12; update();
      cards.filter(card => !card.hidden)[previous]?.querySelector<HTMLAnchorElement>('[data-video-id]')?.focus();
    });
    update();
    const dialog = library.querySelector<HTMLDialogElement>('dialog')!;
    const player = library.querySelector<HTMLElement>('[data-video-player]')!;
    let trigger: HTMLAnchorElement | null = null;
    let overflow = '';
    library.querySelectorAll<HTMLAnchorElement>('[data-video-id]').forEach(link => link.addEventListener('click', event => {
      if (link.dataset.openExternal === 'true' || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); trigger = link;
      const frame = document.createElement('iframe');
      frame.src = link.dataset.videoProvider === "instagram" ? `https://www.instagram.com/reel/${link.dataset.videoId}/embed/` : `https://www.youtube.com/embed/${link.dataset.videoId}?autoplay=1&rel=0&start=${link.dataset.videoStart || 0}`;
      dialog.dataset.format = link.dataset.videoFormat;
      frame.title = link.dataset.videoTitle!;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      player.replaceChildren(frame);
      library.querySelector('[data-playing-title]')!.textContent = link.dataset.videoTitle!;
      const external = library.querySelector<HTMLAnchorElement>('[data-youtube-link]')!;
      external.href = link.href;
      external.textContent = link.dataset.videoProvider === 'instagram' ? 'WATCH ON INSTAGRAM ↗' : 'WATCH ON YOUTUBE ↗';
      overflow = document.documentElement.style.overflow;
      dialog.showModal(); document.documentElement.style.overflow = 'hidden';
    }));
    library.querySelector('[data-video-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { player.replaceChildren(); document.documentElement.style.overflow = overflow; trigger?.focus(); });
  });
</script>
